<Window x:Class="BlurLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlurLink.Desktop.Views"
        Title="BlurLink" Height="720" Width="1080"
        MinHeight="600" MinWidth="880"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource AppFont}" Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ Header bar ============ -->
    <Border Grid.Row="0" Padding="20,14" Background="{StaticResource Sidebar}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
          <!-- Brand -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentDim}">
              <TextBlock Text="B" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Orientation="Vertical" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="BlurLink" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="LAN discovery bridge" FontSize="10.5" Foreground="{StaticResource Faint}" Margin="0,1,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- Nav (pill style, centered) -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,0,0,0">
            <Button Command="{Binding NavigateCommand}" CommandParameter="Join">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <Canvas Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 2,8 A 6,6 0 0 1 14,8" />
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 4.8,8 A 3.2,3.2 0 0 1 11.2,8" />
                  </Canvas>
                  <TextBlock Text="Join" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button.Content>
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBarButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentView, Converter={StaticResource EqualsConverter}, ConverterParameter=Join}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentDim}" />
                      <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Host">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <Canvas Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 3,13 V 7 M 8,13 V 3 M 13,13 V 9" />
                  </Canvas>
                  <TextBlock Text="Host" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button.Content>
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBarButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentView, Converter={StaticResource EqualsConverter}, ConverterParameter=Host}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentDim}" />
                      <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <Canvas Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                          Data="M 2,4.5 H 14 M 2,8.5 H 14 M 2,12.5 H 14" />
                    <Ellipse Width="3" Height="3" Canvas.Left="10" Canvas.Top="3"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Ellipse Width="3" Height="3" Canvas.Left="5.5" Canvas.Top="7"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Ellipse Width="3" Height="3" Canvas.Left="11.5" Canvas.Top="11"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Canvas>
                  <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button.Content>
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavBarButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentView, Converter={StaticResource EqualsConverter}, ConverterParameter=Settings}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentDim}" />
                      <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>

          <!-- Status chip (right) -->
          <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                  CornerRadius="999" Padding="13,6" Background="#131720"
                  BorderBrush="{StaticResource Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse" BasedOn="{StaticResource PulseDot}">
                    <Setter Property="Fill" Value="{StaticResource Muted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Join.BridgeRunning}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Success}" />
                        <DataTrigger.EnterActions>
                          <BeginStoryboard Name="ChipPulse">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.7" Duration="0:0:0.55" />
                              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.7" Duration="0:0:0.55" />
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.55" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <RemoveStoryboard BeginStoryboardName="ChipPulse" />
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Join.HelperLost}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Text" Value="Bridge stopped" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Join.BridgeRunning}" Value="True">
                        <Setter Property="Text" Value="Bridge running" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Host.HostRunning}" Value="True">
                        <Setter Property="Text" Value="Host mode running" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Join.HelperLost}" Value="True">
                        <Setter Property="Text" Value="Helper lost" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </DockPanel>
    </Border>

    <!-- ============ Content ============ -->
    <Grid Grid.Row="1" Margin="28,22,28,10">
      <views:JoinView x:Name="JoinPane" Visibility="Visible" />
      <views:HostView x:Name="HostPane" Visibility="Collapsed" />
      <views:SettingsView x:Name="SettingsPane" Visibility="Collapsed" />
    </Grid>

    <!-- ============ Footer ============ -->
    <Border Grid.Row="2" Background="{StaticResource Sidebar}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,8">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusBar}" Style="{StaticResource FaintText}"
                   FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{Binding Join.Counters}" Style="{StaticResource Mono}" FontSize="10.5"
                     Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
          <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}"
                  Style="{StaticResource QuietButton}" FontSize="11.5" Padding="12,5" Margin="14,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
