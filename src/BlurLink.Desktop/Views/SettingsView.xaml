<UserControl x:Class="BlurLink.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720">
      <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,4,0,20" />

      <!-- ============ Game ============ -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="GAME" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Blur.exe path" Style="{StaticResource FieldLabel}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseCommand}" Margin="10,0,0,4" />
            <TextBox Text="{Binding BlurPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Extra command-line arguments (optional)" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding BlurArgs, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="{StaticResource MonoFont}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Rate limit (packets/sec)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding RateLimit, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                       FontFamily="{StaticResource MonoFont}" Width="130" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Logging (metadata only — never payloads)" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                        Width="220" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
          <WrapPanel Margin="0,16,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="24,10" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" Margin="0,10,0,0"
                     Visibility="{Binding Message, Converter={StaticResource NonEmptyToVis}}" />
        </StackPanel>
      </Border>

      <!-- ============ Connection checks ============ -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="CONNECTION CHECKS" Style="{StaticResource SectionLabel}" />
          <TextBlock Style="{StaticResource FaintText}" Margin="0,0,0,12"
                     Text="Check that Windows sends overlay traffic the right way." />
          <WrapPanel>
            <Button Content="Run route test" Command="{Binding RouteTestCommand}" />
            <Button Content="Ping host" Command="{Binding PingCommand}" />
            <Button Content="Refresh adapters" Command="{Binding RefreshAdaptersCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding RouteResult}" Style="{StaticResource Mono}" Margin="0,12,0,0" />
          <TextBlock Text="{Binding PingResult}" Style="{StaticResource Mono}" />
          <ListBox ItemsSource="{Binding AdaptersSummary}" Height="120"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <!-- ============ Helper log ============ -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="HELPER LOG" Style="{StaticResource SectionLabel}" />
          <TextBlock Style="{StaticResource FaintText}" FontSize="12" Margin="0,0,0,10"
                     Text="Console output of blurlink-net.exe — what the bridge saw and did. Metadata only; never packet contents." />
          <DockPanel Margin="0,0,0,10">
            <CheckBox DockPanel.Dock="Right" Content="Auto-refresh" IsChecked="{Binding AutoRefreshHelperLog}"
                      Style="{StaticResource Switch}" VerticalAlignment="Center" />
            <WrapPanel>
              <Button Content="Refresh now" Command="{Binding RefreshHelperLogCommand}" />
              <Button Content="Copy log" Command="{Binding CopyHelperLogCommand}" />
            </WrapPanel>
          </DockPanel>
          <ListBox ItemsSource="{Binding HelperLogLines}" Height="180"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          <TextBlock Text="{Binding HelperLogStatus}" Style="{StaticResource FaintText}"
                     FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!-- ============ Backup & about ============ -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="BACKUP &amp; RESEARCH NOTES" Style="{StaticResource SectionLabel}" />
          <WrapPanel>
            <Button Content="Export settings" Command="{Binding ExportCommand}" />
            <Button Content="Import settings" Command="{Binding ImportCommand}" />
          </WrapPanel>
          <TextBox Text="{Binding ExportText, UpdateSourceTrigger=PropertyChanged}" Height="100"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" />
          <TextBlock Text="{Binding ResearchSteps, Mode=OneWay}" FontSize="12"
                     Style="{StaticResource MutedText}" />
          <TextBlock Style="{StaticResource FaintText}" FontSize="12" Margin="0,12,0,0"
                     Text="BlurLink 0.1.0 · MIT · No backend, no telemetry, no payload logging. Join mode uses WinDivert (LGPLv3/GPLv2, bundled)." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
