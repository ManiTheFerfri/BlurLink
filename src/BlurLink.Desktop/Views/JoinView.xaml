<UserControl x:Class="BlurLink.Desktop.Views.JoinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720">
      <TextBlock Text="Join a friend's lobby" Style="{StaticResource H1}" Margin="0,4,0,6" />
      <TextBlock Style="{StaticResource SubtleText}" Margin="0,0,0,20"
                 Text="Enter your friend's overlay IP, start the bridge, then open Blur's LAN list." />

      <!-- ============ Connect card ============ -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="CONNECTION" Style="{StaticResource SectionLabel}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Host overlay IP" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding HostIp, UpdateSourceTrigger=PropertyChanged}" MaxLength="15"
                       FontFamily="{StaticResource MonoFont}" FontSize="15" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Your overlay adapter" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                        TextSearch.TextPath="FriendlyName">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FriendlyName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>

          <!-- Pre-flight checklist -->
          <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="12"
                  Background="{StaticResource Input}" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource PulseDot}">
                      <Setter Property="Fill" Value="{StaticResource Muted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PreflightReady}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BridgeRunning}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Success}" />
                          <DataTrigger.EnterActions>
                            <BeginStoryboard Name="JoinPulse">
                              <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.7" Duration="0:0:0.55" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.7" Duration="0:0:0.55" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.55" />
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="JoinPulse" />
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding PreflightSummary, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding PreflightItems}" Margin="18,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2.5">
                      <TextBlock FontSize="11.5" VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="○" />
                            <Setter Property="Foreground" Value="{StaticResource Faint}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Ok}" Value="True">
                                <Setter Property="Text" Value="✓" />
                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Ok}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Faint}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Ok}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding RouteWarning}" Foreground="{StaticResource Danger}"
                     FontSize="12" Margin="0,10,0,0"
                     Visibility="{Binding RouteWarning, Converter={StaticResource NonEmptyToVis}}" />

          <WrapPanel Margin="0,16,0,0">
            <Button Content="Start Bridge" Command="{Binding StartStopCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="30,12" FontSize="14"
                    Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}" />
            <Button Content="Stop Bridge" Command="{Binding StartStopCommand}"
                    Style="{StaticResource DangerButton}" Padding="30,12" FontSize="14"
                    Visibility="{Binding BridgeRunning, Converter={StaticResource BoolToVis}}" />
            <Button Content="Force kill" Command="{Binding ForceKillCommand}"
                    Style="{StaticResource DangerButton}"
                    Visibility="{Binding ShowForceKill, Converter={StaticResource BoolToVis}}" />
            <Button Content="Launch Blur" Command="{Binding LaunchBlurCommand}" />
          </WrapPanel>

          <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" Margin="0,10,0,0"
                     Visibility="{Binding Message, Converter={StaticResource NonEmptyToVis}}" />
          <TextBlock Text="{Binding BlurStatus, Mode=OneWay}" Style="{StaticResource FaintText}"
                     FontSize="12" Margin="0,2,0,0"
                     Visibility="{Binding BlurStatus, Converter={StaticResource NonEmptyToVis}}" />
          <TextBlock Text="{Binding RepliesSummary, Mode=OneWay}" Foreground="{StaticResource Success}"
                     FontSize="12" Margin="0,2,0,0"
                     Visibility="{Binding RepliesSummary, Converter={StaticResource NonEmptyToVis}}" />
        </StackPanel>
      </Border>

      <!-- ============ Advanced card ============ -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}" />

          <!-- Port detector -->
          <Border Background="{StaticResource Input}" BorderBrush="{StaticResource Border}"
                  BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="🔍" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Don't know the discovery port?" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Style="{StaticResource FaintText}" FontSize="12" Margin="0,2,0,10"
                         Text="Listen for 15 seconds while you refresh Blur's LAN list. Nothing is changed or blocked while listening." />
              <WrapPanel>
                <Button Content="Detect discovery port" Command="{Binding DetectCommand}" />
                <Button Content="Stop listening" Command="{Binding StopSniffCommand}" />
                <Button Content="Listen for replies" Command="{Binding ListenRepliesCommand}" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse" BasedOn="{StaticResource PulseDot}">
                      <Setter Property="Fill" Value="{StaticResource Accent}" />
                      <Setter Property="Visibility" Value="{Binding SniffRunning, Converter={StaticResource BoolToVis}}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SniffRunning}" Value="True">
                          <DataTrigger.EnterActions>
                            <BeginStoryboard Name="RadarPulse">
                              <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.7" Duration="0:0:0.55" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.7" Duration="0:0:0.55" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.55" />
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="RadarPulse" />
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding SniffStatus}" Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center"
                           Visibility="{Binding SniffStatus, Converter={StaticResource NonEmptyToVis}}" />
              </StackPanel>
              <Button Content="{Binding SniffCandidate, Mode=OneWay, StringFormat='Use port {0}'}"
                      Command="{Binding ApplySniffCommand}"
                      Visibility="{Binding ShowApplySniff, Converter={StaticResource BoolToVis}}"
                      Margin="0,10,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <!-- Tune fields -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Discovery UDP port" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding DiscoveryPort, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                       FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Broadcast destination" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding BroadcastDestination, UpdateSourceTrigger=PropertyChanged}" MaxLength="15"
                       FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Payload signature hex (optional)" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PayloadHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="191"
                   FontFamily="{StaticResource MonoFont}" />
          <CheckBox Content="Keep physical LAN working (recommended)" IsChecked="{Binding PreserveBroadcast}"
                    Style="{StaticResource Switch}" Margin="0,14,0,0" />
          <CheckBox Content="Stop bridge when Blur exits" IsChecked="{Binding StopWhenBlurExits}"
                    Style="{StaticResource Switch}" Margin="0,2" />

          <TextBlock Text="Active filter" Style="{StaticResource FieldLabel}" Margin="1,14,0,7" />
          <TextBox Text="{Binding ActiveFilter, Mode=OneWay}" IsReadOnly="True"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
          <TextBlock Text="Recent packets (metadata only)" Style="{StaticResource FieldLabel}" Margin="1,10,0,7" />
          <ListBox ItemsSource="{Binding RecentEvents}" Height="130"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
          <Button Content="Refresh adapters" Command="{Binding RefreshAdaptersCommand}"
                  Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
