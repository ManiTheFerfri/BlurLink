<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlurLink.Shell.ViewModels"
             xmlns:views="using:BlurLink.Shell.Views"
             x:Class="BlurLink.Shell.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BlurLink/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://BlurLink/Themes/Controls.axaml" />
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:JoinViewModel}">
      <views:JoinView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HostViewModel}">
      <views:HostView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
      <views:DiagnosticsView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
