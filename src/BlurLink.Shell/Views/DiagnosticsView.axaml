<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlurLink.Shell.ViewModels"
             x:Class="BlurLink.Shell.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <StackPanel MaxWidth="720">
    <TextBlock Text="Diagnostics" Classes="h1" Margin="0,4,0,6" />
    <TextBlock Classes="faint" Margin="0,0,0,20" TextWrapping="Wrap"
               Text="Console output of blurlink-net.exe — what the bridge saw and did. Metadata only; never packet contents." />

    <!-- ============ Helper log ============ -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="HELPER LOG" Classes="label" />
        <DockPanel LastChildFill="True" Margin="0,0,0,10">
          <CheckBox DockPanel.Dock="Right" Content="Auto-refresh" IsChecked="{Binding AutoRefreshHelperLog}"
                    VerticalAlignment="Center" />
          <WrapPanel>
            <Button Content="Refresh now" Command="{Binding RefreshHelperLogCommand}" />
            <Button x:Name="CopyLogButton" Content="Copy log" Command="{Binding CopyHelperLogCommand}"
                    AutomationProperties.Name="Copy helper log" />
          </WrapPanel>
        </DockPanel>
        <ListBox ItemsSource="{Binding HelperLogLines}" Height="180"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
        <TextBlock Text="{Binding HelperLogStatus}" Classes="faint"
                   FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- ============ Support bundle (Task 10) ============ -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="SUPPORT BUNDLE" Classes="label" />
        <TextBlock Classes="faint" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="One click: app logs plus diagnostics metadata, zipped. Logs only — a stray capture in the logs folder can never enter a bundle." />
        <WrapPanel>
          <Button Content="Create support bundle" Command="{Binding BundleCommand}"
                  AutomationProperties.Name="Create support bundle" />
        </WrapPanel>
        <TextBlock Text="{Binding BundleResult}" TextWrapping="Wrap"
                   FontSize="11" Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <!-- ============ Crash log (Task 10) ============ -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="CRASH LOG" Classes="label" />
        <TextBlock Classes="faint" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Newest local crash capture (last 20 lines). Metadata only; never packet contents." />
        <TextBlock Text="{Binding CrashTail}" TextWrapping="Wrap"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
      </StackPanel>
    </Border>

    <!-- ============ Verify profile (Task 9) ============ -->
    <Border Classes="card" IsVisible="{Binding HasVerify}">
      <StackPanel>
        <TextBlock Text="VERIFY PROFILE" Classes="label" />
        <TextBlock Classes="faint" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Paste the first 16+ payload bytes from three Wireshark captures. The first 12 bytes must match across all three before a verified profile can be written." />
        <TextBlock Text="Capture 1" Classes="label" />
        <TextBox Text="{Binding Verify.Sample1}" PlaceholderText="Paste first 16+ payload bytes from Wireshark"
                 FontFamily="{StaticResource MonoFont}" />
        <TextBlock Text="Capture 2" Classes="label" />
        <TextBox Text="{Binding Verify.Sample2}" PlaceholderText="Paste first 16+ payload bytes from Wireshark"
                 FontFamily="{StaticResource MonoFont}" />
        <TextBlock Text="Capture 3" Classes="label" />
        <TextBox Text="{Binding Verify.Sample3}" PlaceholderText="Paste first 16+ payload bytes from Wireshark"
                 FontFamily="{StaticResource MonoFont}" />
        <TextBlock Text="Profile name" Classes="label" />
        <TextBox Text="{Binding Verify.ProfileName}" MaxLength="80" />
        <WrapPanel Margin="0,12,0,0">
          <Button Content="Check prefix stability" Command="{Binding Verify.CheckCommand}"
                  AutomationProperties.Name="Check prefix stability" />
          <Button Content="Write verified profile" Command="{Binding Verify.WriteCommand}"
                  AutomationProperties.Name="Write verified profile" />
        </WrapPanel>
        <TextBlock x:Name="VerifyResult" Text="{Binding Verify.Result}" TextWrapping="Wrap"
                   Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
