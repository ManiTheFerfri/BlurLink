<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlurLink.Shell.ViewModels"
             xmlns:conv="using:BlurLink.Shell.Converters"
             x:Class="BlurLink.Shell.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel MaxWidth="720">
    <TextBlock Text="Settings" Classes="h1" Margin="0,4,0,20" />

    <!-- ============ Game ============ -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="GAME" Classes="label" />
        <TextBlock Text="Blur.exe path" Classes="label" />
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseCommand}" Margin="10,0,0,4"
                  AutomationProperties.Name="Browse for Blur.exe" />
          <TextBox Text="{Binding BlurPath}" VerticalContentAlignment="Center"
                   AutomationProperties.Name="Blur.exe path" />
        </DockPanel>
        <TextBlock Text="Extra command-line arguments (optional)" Classes="label" />
        <TextBox Text="{Binding BlurArgs}"
                 AutomationProperties.Name="Extra command-line arguments"
                 FontFamily="{StaticResource MonoFont}" />
        <Grid ColumnDefinitions="Auto,24,*">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Rate limit (packets/sec)" Classes="label" />
            <TextBox Text="{Binding RateLimit}" MaxLength="3"
                     AutomationProperties.Name="Rate limit"
                     FontFamily="{StaticResource MonoFont}" Width="130" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Logging (metadata only — never payloads)" Classes="label" />
            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                      AutomationProperties.Name="Logging level"
                      Width="220" HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
        <WrapPanel Margin="0,16,0,0">
          <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}"
                  Classes="primary" Padding="24,10"
                  AutomationProperties.Name="Save settings" />
          <Button Content="Reset" Command="{Binding ResetCommand}"
                  AutomationProperties.Name="Reset settings" />
          <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                  AutomationProperties.Name="Open log folder" />
        </WrapPanel>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" Margin="0,10,0,0"
                   IsVisible="{Binding Message, Converter={x:Static conv:NonEmptyToVisibleConverter.Instance}}" />
      </StackPanel>
    </Border>

    <!-- ============ Connection checks ============ -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="CONNECTION CHECKS" Classes="label" />
        <TextBlock Classes="faint" Margin="0,0,0,12"
                   Text="Check that Windows sends overlay traffic the right way." />
        <WrapPanel>
          <Button Content="Run route test" Command="{Binding RouteTestCommand}"
                  AutomationProperties.Name="Run route test" />
          <Button Content="Ping host" Command="{Binding PingCommand}"
                  AutomationProperties.Name="Ping host" />
          <Button Content="Refresh adapters" Command="{Binding RefreshAdaptersCommand}"
                  AutomationProperties.Name="Refresh adapters" />
        </WrapPanel>
        <TextBlock Text="{Binding RouteResult}" Classes="mono" Margin="0,12,0,0" />
        <TextBlock Text="{Binding PingResult}" Classes="mono" />
        <ListBox ItemsSource="{Binding AdaptersSummary}" Height="120"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <!-- ============ Backup & about ============ -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="BACKUP &amp; RESEARCH NOTES" Classes="label" />
        <WrapPanel>
          <Button Content="Export settings" Command="{Binding ExportCommand}"
                  AutomationProperties.Name="Export settings" />
          <Button Content="Import settings" Command="{Binding ImportCommand}"
                  AutomationProperties.Name="Import settings" />
        </WrapPanel>
        <TextBox Text="{Binding ExportText}" Height="100"
                 AutomationProperties.Name="Exported settings"
                 FontFamily="{StaticResource MonoFont}" FontSize="11.5" AcceptsReturn="True"
                 Margin="0,12,0,12" />
        <TextBlock Text="{Binding ResearchSteps, Mode=OneWay}" FontSize="12"
                   Classes="faint" TextWrapping="Wrap" />
        <TextBlock Classes="faint" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="{Binding AboutVersion, Mode=OneWay}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
