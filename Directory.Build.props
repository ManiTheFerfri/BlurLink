<Project>
  <!-- Shared MSBuild settings for all C# projects. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <!-- Vulnerability audit runs explicitly in CI (dotnet list package
         vulnerable). Local builds must not hard-fail when nuget.org is
         unreachable (NU1900 combined with warnings-as-errors). -->
    <NuGetAudit>false</NuGetAudit>
    <Company>BlurLink Contributors</Company>
    <Product>BlurLink</Product>
    <Copyright>Copyright (c) 2026 BlurLink Contributors (MIT)</Copyright>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
  </PropertyGroup>

  <!-- Debug/Release shared settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
</Project>
